# Copy this file to android/keystore.properties and fill in real values.
# The real keystore.properties is git-ignored -- never commit it.
#
# Generate the keystore once (from the android/ directory):
#   keytool -genkey -v -keystore maximus-release.keystore \
#     -alias maximus-release -keyalg RSA -keysize 2048 -validity 10000
#
# Then place maximus-release.keystore inside android/ and reference it below.

storeFile=maximus-release.keystore
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=maximus-release
keyPassword=CHANGE_ME_KEY_PASSWORD
